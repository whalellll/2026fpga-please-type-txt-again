diff --git a/src/bitboard.h b/src/bitboard.h
index 2b092fc..a0b4193 100644
--- a/src/bitboard.h
+++ b/src/bitboard.h
@@ -165,7 +165,7 @@ inline int popcount(Bitboard b) {
 
 #else  // Assumed gcc or compatible compiler
 
-    return __builtin_popcountll(b >> 64) + __builtin_popcountll(b);
+    return __builtin_popcountll(u64(b >> 64)) + __builtin_popcountll(u64(b));
 
 #endif
 }
@@ -191,8 +191,8 @@ inline Square lsb(Bitboard b) {
 #else  // Assumed gcc or compatible compiler
 
     if (u64(b))
-        return Square(__builtin_ctzll(b));
-    return Square(__builtin_ctzll(b >> 64) + 64);
+        return Square(__builtin_ctzll(u64(b)));
+    return Square(__builtin_ctzll(u64(b >> 64)) + 64);
 
 #endif
 }
