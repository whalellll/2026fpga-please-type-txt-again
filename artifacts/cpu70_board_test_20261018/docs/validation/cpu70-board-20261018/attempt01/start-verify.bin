
/ # p=$(cat /tmp/voice-gui-display/gui-v3.pid); kill "$p"; n=0; while kill -0 "$
p" 2>/dev/null; do sleep 1; n=$((n+1)); test "$n" -lt 15 || break; done; ! kill 
-0 "$p" 2>/dev/null; printf "\n__BOARD_END_0:%s\n" "$?"

__BOARD_END_0:0
/ # cd /tmp/voice-gui-display; unset PIKAFISH_MAC_BACKEND; PIKAFISH_MAC_REQUIRE_
DRIVER=1 PIKAFISH_STAGEB_ACCEL=verify XQ_GUI_INPUT=/run/voice-display.in ./xiang
qi-gui-display-v3 </dev/null >gui-verify.log 2>&1 & echo $! >gui-v3.pid; sleep 8
; tail -15 gui-verify.log; kill -0 $(cat gui-v3.pid); printf "\n__BOARD_END_1:%s
\n" "$?"
