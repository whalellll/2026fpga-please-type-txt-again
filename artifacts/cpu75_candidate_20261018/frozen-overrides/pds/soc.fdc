define_attribute {p:audio_ws} {PAP_IO_VCCIO} {3.3}
define_attribute {p:audio_ws} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:audio_ws} {PAP_IO_DRIVE} {8}
define_attribute {p:audio_ws} {PAP_IO_SLEW} {SLOW}
define_attribute {p:audio_ws} {PAP_IO_NONE} {TRUE}

# J3-27: serial data from INMP441 microphone to FPGA.
define_attribute {p:microphone_sd} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:microphone_sd} {PAP_IO_LOC} {U16}
define_attribute {p:microphone_sd} {PAP_IO_VCCIO} {3.3}
define_attribute {p:microphone_sd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:microphone_sd} {PAP_IO_NONE} {TRUE}

# J3-28: optional serial data from FPGA to MAX98357A.
define_attribute {p:spk_din} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:spk_din} {PAP_IO_LOC} {U15}
define_attribute {p:spk_din} {PAP_IO_VCCIO} {3.3}
define_attribute {p:spk_din} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:spk_din} {PAP_IO_DRIVE} {8}
define_attribute {p:spk_din} {PAP_IO_SLEW} {SLOW}
define_attribute {p:spk_din} {PAP_IO_NONE} {TRUE}

# CPU/SYS AXI FIFO Gray-pointer launch to first synchronizer stage.
# PDS constraint import sees each 5-bit pointer as one RTL vector cell. ADS
# preserves five Gray source FFs under these directed timing constraints.
# CCR matches one vector pair; ADS checks all five FFs and 300 endpoint tags.
# Bounds are min(16 ns, faster CPU/SYS period minus 0.8 ns), floored to 1 ps.
# Only the artificial asynchronous hold arc is cut; stage1->stage2 remains timed.
set_max_delay -from [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/wr_gray\[4:0\]$}] -to [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/wr_gray_rd1\[4:0\]$}] -datapath_only 12.533
set_max_skew -from [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/wr_gray\[4:0\]$}] -to [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/wr_gray_rd1\[4:0\]$}] 12.533
set_false_path -hold -from [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/wr_gray\[4:0\]$}] -to [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/wr_gray_rd1\[4:0\]$}]
set_max_delay -from [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/rd_gray\[4:0\]$}] -to [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/rd_gray_wr1\[4:0\]$}] -datapath_only 12.533
