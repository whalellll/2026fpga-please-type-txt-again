# 100H baseboard J10 MicroSD native SD bus, Bank_L3 = 3.3 V.
# CMD and DAT[3:0] are bidirectional at the socket.  This read-only host
# actively drives only CMD; all DAT lanes remain released for card data and
# DAT0 busy.  SDDEF/card detect is pulled high and the socket switch pulls it
# low when a card is inserted.
define_attribute {p:sd_clk} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:sd_clk} {PAP_IO_LOC} {F19}
define_attribute {p:sd_clk} {PAP_IO_VCCIO} {3.3}
