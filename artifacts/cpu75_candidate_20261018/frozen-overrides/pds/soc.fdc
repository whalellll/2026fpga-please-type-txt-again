# First-stage reset and interrupt synchronizers: source-clock filter leaves stage1-to-stage2 timed.
set_max_delay -from [get_clocks {cpu_clk}] -to [get_cells -hierarchical -regexp {.*u_axi_cdc/cpu_ready_sys\[1:0\]$}] -datapath_only 12.533
set_false_path -hold -from [get_clocks {cpu_clk}] -to [get_cells -hierarchical -regexp {.*u_axi_cdc/cpu_ready_sys\[1:0\]$}]
