# PLL clocks from the 27 MHz board oscillator.  The CPU clock is a separate
# CLKOUT3 network even at the initial 891/18 = 49.5 MHz divider.
create_clock -name {pix_clk} -period {13.468} [get_nets {u_video_pll/clkout0}]
create_clock -name {sys_clk} -period {20.202020} [get_nets {u_video_pll/clkout1}]
create_clock -name {i2c_cfg_clk} -period {141.43} [get_nets {u_video_pll/clkout2}]
create_clock -name {cpu_clk} -period {13.333333} [get_nets {g_dedicated_cpu.u_cpu_pll/clkout3}]
create_generated_clock -name {sd_native_clk} -source [get_nets {u_video_pll/clkout1}] [get_ports {sd_clk}] -master_clock [get_clocks {sys_clk}] -divide_by {2}
create_generated_clock -name {camera1_sccb_clk} -source [get_nets {u_video_pll/clkout1}] [get_nets {u_dual_ov5640/camera1_register_init_inst/sccb_clock}] -master_clock [get_clocks {sys_clk}] -divide_by {4950}
create_generated_clock -name {camera2_sccb_clk} -source [get_nets {u_video_pll/clkout1}] [get_nets {u_dual_ov5640/camera2_register_init_inst/sccb_clock}] -master_clock [get_clocks {sys_clk}] -divide_by {4950}
set_clock_groups -name {sys_to_camera1_sccb} -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {camera1_sccb_clk}]
set_clock_groups -name {sys_to_camera2_sccb} -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {camera2_sccb_clk}]
set_clock_groups -name {sys_to_hdmi} -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {pix_clk}]
set_clock_groups -name {hdmi_to_i2c} -asynchronous -group [get_clocks {pix_clk}] -group [get_clocks {i2c_cfg_clk}]
set_clock_groups -name {sys_to_ddr} -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {ddrphy_sysclk}]
set_clock_groups -name {fb_to_ddr} -asynchronous -group [get_clocks {pix_clk}] -group [get_clocks {ddrphy_sysclk}]
set_clock_groups -name {sys_to_rgmii} -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {rgmii_rxc}]
set_clock_groups -name {sys_to_i2c} -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {i2c_cfg_clk}]

# CPU/SYS remain timed as distinct clocks.  Directed FIFO pointer bounds are
# declared below and checked against PDS CCR and mapped FF annotations by
# audit_cpu_sys_cdc_ads.py.  The two clock groups have no broad false path;
# only the ten pointer launch-to-first-stage hold arcs are cut.

