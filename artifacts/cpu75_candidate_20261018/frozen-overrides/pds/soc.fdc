# FIFO payload crosses only after the synchronized Gray pointer permits a stable read.
set_max_delay -from [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/storage(_[0-9_]+)?$}] -to [get_clocks {sys_clk}] -datapath_only 12.533
set_false_path -hold -from [get_cells -hierarchical -regexp {.*u_axi_cdc/u_ar_fifo/storage(_[0-9_]+)?$}] -to [get_clocks {sys_clk}]
