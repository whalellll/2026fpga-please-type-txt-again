#!/bin/sh

PIDFILE=/run/xiangqi-pikafish.pid
CONTROL_FIFO=/run/xiangqi-pikafish.in
PIKAFISH_STAGEB_ACCEL="${PIKAFISH_STAGEB_ACCEL:-1}"
export PIKAFISH_STAGEB_ACCEL
PIKAFISH_MAC_BACKEND="${PIKAFISH_MAC_BACKEND:-mmio-shadow}"
export PIKAFISH_MAC_BACKEND

start_gui() {
    if [ ! -x /usr/bin/xiangqi-pikafish-gui ]; then
        echo "Full Pikafish image is incomplete"
        return 1
    fi
    if [ -s "$PIDFILE" ]; then
        pid="$(cat "$PIDFILE")"
        if kill -0 "$pid" 2>/dev/null; then
            echo "Full Pikafish GUI already running: pid=$pid"
            return 0
        fi
        rm -f "$PIDFILE"
    fi

    if [ -e "$CONTROL_FIFO" ] && [ ! -p "$CONTROL_FIFO" ]; then
        echo "Software input path is not a FIFO: $CONTROL_FIFO" >&2
        return 1
    fi
    if [ ! -p "$CONTROL_FIFO" ]; then
        mkfifo "$CONTROL_FIFO" || return 1
        chmod 0660 "$CONTROL_FIFO"
    fi
    echo "Starting full Pikafish GUI; software input: $CONTROL_FIFO"
    /usr/bin/xiangqi-pikafish </dev/null >/dev/console 2>&1 &
    pid=$!
    echo "$pid" > "$PIDFILE"
    echo "Full Pikafish GUI launched: pid=$pid"
}

stop_gui() {
    if [ ! -s "$PIDFILE" ]; then
        return 0
    fi
    pid="$(cat "$PIDFILE")"
    if kill -0 "$pid" 2>/dev/null; then
        echo "Stopping full Pikafish GUI: pid=$pid"
        kill "$pid"
    fi
    rm -f "$PIDFILE"
    rm -f "$CONTROL_FIFO"
}

case "$1" in
    start)
        start_gui
        ;;
    stop)
        stop_gui
        ;;
    restart)
        stop_gui
        start_gui
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac

exit $?
