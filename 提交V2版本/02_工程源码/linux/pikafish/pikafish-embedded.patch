diff --git a/src/nnue/nnue_common.h b/src/nnue/nnue_common.h
--- a/src/nnue/nnue_common.h
+++ b/src/nnue/nnue_common.h
@@ -105,6 +105,25 @@ constexpr IntType ceil_to_multiple(IntType n, IntType base) {
 }
 
 
+#if defined(PIKAFISH_PFF1_DIRECT_VIEW)
+// Keep the RV32 direct-view copy simple and bounded. Volatile source loads
+// avoid target-libc memcpy variants that issue wide accesses on this SoC.
+inline bool read_pff1_direct(const char*& cursor, const char* end, void* output,
+                             usize bytes) {
+    if (cursor == nullptr || end == nullptr || cursor > end
+        || bytes > static_cast<usize>(end - cursor))
+        return false;
+
+    const auto* input = reinterpret_cast<volatile const unsigned char*>(cursor);
+    auto* destination = static_cast<unsigned char*>(output);
+    for (usize i = 0; i < bytes; ++i)
+        destination[i] = input[i];
+    cursor += bytes;
+    return true;
+}
+#endif
+
+
 // Utility to read an integer (signed or unsigned, any size)
 // from a stream in little-endian order. We swap the byte order after the read if
 // necessary to return a result with the byte ordering of the compiling machine.
