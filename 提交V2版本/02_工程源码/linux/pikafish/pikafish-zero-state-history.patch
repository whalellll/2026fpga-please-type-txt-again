diff --git a/src/memory.h b/src/memory.h
--- a/src/memory.h
+++ b/src/memory.h
@@ -161,6 +161,44 @@ memory_allocator(ALLOC_FUNC alloc_func, usize num) {
     return reinterpret_cast<ElementType*>(raw_memory + array_offset);
 }
 
+#if defined(PIKAFISH_EMBEDDED_SINGLE_THREAD)
+// Linux anonymous large-page mappings are already zero-filled. These helpers
+// start the lifetime of trivial history objects without value-initializing and
+// rewriting every byte of those fresh pages.
+template<typename T, typename ALLOC_FUNC>
+inline std::enable_if_t<!std::is_array_v<T>, T*>
+memory_allocator_fresh_zero(ALLOC_FUNC alloc_func) {
+    static_assert(std::is_trivially_default_constructible_v<T>);
+    static_assert(std::is_trivially_destructible_v<T>);
+    void* raw_memory = alloc_func(sizeof(T));
+    if (raw_memory == nullptr)
+        report_failed_allocation(sizeof(T));
+    ASSERT_ALIGNED(raw_memory, alignof(T));
+    return new (raw_memory) T;
+}
+
+template<typename T, typename ALLOC_FUNC>
+inline std::enable_if_t<std::is_array_v<T>, std::remove_extent_t<T>*>
+memory_allocator_fresh_zero(ALLOC_FUNC alloc_func, usize num) {
+    using ElementType = std::remove_extent_t<T>;
+    static_assert(std::is_trivially_default_constructible_v<ElementType>);
+    static_assert(std::is_trivially_destructible_v<ElementType>);
+
+    const usize array_offset = std::max(sizeof(usize), alignof(ElementType));
+    const usize bytes        = array_offset + num * sizeof(ElementType);
+    char*       raw_memory   = reinterpret_cast<char*>(alloc_func(bytes));
+    if (raw_memory == nullptr)
+        report_failed_allocation(bytes);
+    ASSERT_ALIGNED(raw_memory, alignof(T));
+
+    new (raw_memory) usize(num);
+    for (usize i = 0; i < num; ++i)
+        new (raw_memory + array_offset + i * sizeof(ElementType)) ElementType;
+
+    return reinterpret_cast<ElementType*>(raw_memory + array_offset);
+}
+#endif
+
 //
 //
 // aligned large page unique ptr
@@ -207,6 +245,25 @@ std::enable_if_t<std::is_array_v<T>, LargePagePtr<T>> make_unique_large_page(usi
     return LargePagePtr<T>(memory);
 }
 
+#if defined(PIKAFISH_EMBEDDED_SINGLE_THREAD)
+template<typename T>
+std::enable_if_t<!std::is_array_v<T>, LargePagePtr<T>> make_unique_large_page_fresh_zero() {
+    static_assert(alignof(T) <= 4096);
+    T* obj = memory_allocator_fresh_zero<T>(aligned_large_pages_alloc);
+    return LargePagePtr<T>(obj);
+}
+
+template<typename T>
+std::enable_if_t<std::is_array_v<T>, LargePagePtr<T>>
+make_unique_large_page_fresh_zero(usize num) {
+    using ElementType = std::remove_extent_t<T>;
+    static_assert(alignof(ElementType) <= 4096);
+    ElementType* memory =
+      memory_allocator_fresh_zero<T>(aligned_large_pages_alloc, num);
+    return LargePagePtr<T>(memory);
+}
+#endif
