+            return 0;
+        hash_combine(h, hash_bytes(reinterpret_cast<const char*>(biases.data()), BiasesBytes));
+        hash_combine(h, hash_bytes(reinterpret_cast<const char*>(weights.data()), WeightsBytes));
+        hash_combine(h, hash_bytes(reinterpret_cast<const char*>(psqtWeights.data()),
+                                   PsqtWeightsBytes));
+        hash_combine(h, hash_bytes(reinterpret_cast<const char*>(threatWeights.data()),
