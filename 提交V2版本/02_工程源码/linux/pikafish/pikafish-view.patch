     usize get_content_hash() const {
         usize h = 0;
 
+#if defined(PIKAFISH_PFF1_DIRECT_VIEW)
+        if (biases.data() == nullptr || weights.data() == nullptr
+            || psqtWeights.data() == nullptr || threatWeights.data() == nullptr
