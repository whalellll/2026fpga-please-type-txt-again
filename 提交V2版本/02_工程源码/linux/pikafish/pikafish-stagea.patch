+struct StageATerms {
+    std::array<const i8*, StageAAccel::MaxTerms> rows{};
+    std::array<i8, StageAAccel::MaxTerms>        coefficients{};
+    usize                                        count = 0;
+
+    template<typename List>
+    bool append(const List& list, const i8* weights, i8 coefficient) {
+        if ((coefficient != 1 && coefficient != -1)
+            || count + static_cast<usize>(list.size()) > StageAAccel::MaxTerms)
+            return false;
+        for (int i = 0; i < list.ssize(); ++i)
+        {
+            rows[count] = weights + static_cast<usize>(list[i]) * Dimensions;
+            coefficients[count] = coefficient;
+            ++count;
+        }
+        return true;
+    }
+};
+
+bool apply_stage_a(const i16* base, i16* out, const StageATerms& terms) {
+    return StageAAccel::apply(base, out, terms.rows.data(), terms.coefficients.data(),
+                              terms.count);
+}
